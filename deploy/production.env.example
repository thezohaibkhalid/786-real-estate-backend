# Save as /opt/786/.env, mode 600. Values are literal; do not add shell quotes.
# This is the production source of truth. /opt/786/env/*.env is generated.
PUBLIC_SITE_URL=https://786.zohaibkhalid.me
ADMIN_SITE_URL=https://786-admin.zohaibkhalid.me
API_INTERNAL_BASE_URL=http://backend:8080/api
ADMIN_API_PROXY_URL=http://backend:8080/api/admin
PUBLIC_SITE_INTERNAL_URL=http://frontend:3000
DATABASE_URL=postgres://replace-with-hosted-database
DB_MAX_CONNS=3
IMAGE_WORKERS=1
# Actual Docker network gateway, obtained with docker network inspect.
TRUSTED_PROXIES=172.18.0.1
SESSION_SECRET=replace-with-64-random-hex-characters
REVALIDATE_SECRET=replace-with-another-64-random-hex-secret
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_SECURE=false
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=786realestates-images
R2_PUBLIC_BASE_URL=
