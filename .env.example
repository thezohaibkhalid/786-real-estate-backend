# Export these variables before running; .env is not automatically loaded.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://realestate:localdev@localhost:5433/realestate?sslmode=disable
ADMIN_ORIGIN=http://localhost:3001
DB_MAX_CONNS=10
IMAGE_WORKERS=2
# Only the Nginx/Docker gateway that overwrites X-Real-IP; leave blank for direct access.
TRUSTED_PROXIES=
SESSION_SECRET=dev-only-change-me-786-real-estate-session-secret
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_SECURE=false
EMAIL_SERVER_USER=your-smtp-user@example.com
EMAIL_SERVER_PASSWORD=your-smtp-app-password
EMAIL_FROM=your-smtp-user@example.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=786realestates-images
# Use the public r2.dev URL assigned by Cloudflare, without a trailing slash.
R2_PUBLIC_BASE_URL=https://your-r2-public-subdomain.r2.dev
